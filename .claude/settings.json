{
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "aoa enforce deny",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "aoa enforce record",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "aoa enforce commit",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "aoa enforce fail",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "aoa enforce check",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ]
  }
}
