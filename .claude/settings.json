{
  "aoa": {
    "enforce_hook_set_version": 2
  },
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/aoa-enforce deny",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/aoa-enforce record",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/aoa-enforce commit",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/aoa-enforce fail",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/aoa-enforce check",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ]
  }
}
