
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Rust build output
target/

# AOA toolkit local state
.aoa/

# Local tooling / config, except the aoa runtime hooks and the wrapper they
# run — both are generated by `aoa observe --enforce` and tracked, because
# hooks pointing at an untracked file are hooks that do not run on a fresh
# clone (see README "Runtime hooks")
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/aoa-enforce
.prd-build/
.mcp.json

# Internal planning docs (not public)
prd_aoa_toolkit.md
premortem_aoa_toolkit.md
report.md

# Vendored ESLint install; regenerate with `npm ci` in
# crates/aoa-migrate/assets/eslint (package-lock.json is committed)
crates/aoa-migrate/assets/eslint/node_modules/

# Gas City
.beads/*
!.beads/identity.toml

# Agent-harness scaffolding (stray scratch dirs from containerized runs)
/aoa-*/
/worktrees/
/.gc/
/.gc-reports/
/.agents/
/.gc-context/
/.codex/
/.ruff_cache/
.DS_Store
