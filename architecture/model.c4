// The AOA Toolkit — measures whether a repository works for AI coding agents
// by running an agent against tasks mined from the repository's own git
// history and scoring what it did, rather than checking for the presence of
// files like AGENTS.md.
//
// The Rust workspace's crates, grouped into a domain kernel, a trace +
// symbol-graph substrate, read-only measurement, trust gates (R0/R5/R7), and a
// single repository-mutating migration path kept behind the falsification
// gate. Planned and research work is tagged so it renders distinctly from what
// is already built (see spec.c4 for the tag legend).
//
// ─────────────────────────────────────────────────────────────────────────────
// THIS FILE IS A MAINTAINED CONTRACT, NOT A SNAPSHOT (aoa-enzj8, recorded in
// docs/adr/0006-architecture-model-conformance.md).
//
// crates/aoa/tests/architecture_model.rs holds it to the workspace and fails
// the build when the two disagree:
//
//   - Every crate under crates/ is exactly one element here.
//   - And the other way round: every element that claims to be code stands for
//     a crate — it links one, or it groups elements that do. An element claims
//     to be code by sitting inside the `aoa` system, or by being declared
//     `container` or `component` anywhere in this file. Naming a crate in an
//     element's TITLE is not standing for it. The title is what the diagram
//     renders and nothing reads it, so an element that only names a crate is a
//     box on the published picture that no test can contradict, and every arrow
//     at it is dropped as an arrow to the outside world. An element with no code
//     behind it is an actor or an externalSystem, where the shape says so.
//   - Every arrow between two crate-backed elements is a real production
//     dependency of the source on the target.
//   - Every production dependency between two library crates is drawn, so
//     deleting an arrow instead of fixing what it describes fails as loudly as
//     drawing a wrong one.
//   - The `aoa` CLI is the single exception to that last rule. It depends on
//     every library, so drawing all of its edges would say nothing; its arrows
//     are drawn where they carry meaning and are checked only for being true.
//   - No arrow may be drawn at a container standing for several crates. One
//     holding a single crate (aoa.migrate) resolves to it and is checked like
//     any other; one holding several (aoa.substrate, aoa.measure) names neither
//     end of what it claims, so nothing could check it. Draw it between the
//     components that have the dependency.
//   - #conceptual marks an arrow that is deliberately not a code edge. Each one
//     is registered with its reason in that test, and the registration is
//     deleted the moment the edge becomes real.
//
// Containers group by concern, not by layer. Which layer a crate belongs to,
// and which direction dependencies may point, is CLAUDE.md's contract, enforced
// separately by crates/aoa/tests/architecture_doc.rs. The two do not line up
// element for element — `recommend` sits under measurement here and in
// decisions there — so reading one as the other will mislead you.
// ─────────────────────────────────────────────────────────────────────────────
//
// Elements carry `link`s to their source crate so a reviewer can jump from
// any box straight to the code. The PRD, premortem, and evidence-audited
// report that shaped this design are gitignored working documents, not part
// of the published repo, so they are described inline rather than linked.

model {

  operator = actor 'Operator' {
    description 'Runs the aoa CLI against a repository and decides, informed by falsify, whether to trust migrate'
  }

  agentUnderTest = actor 'Coding agent under test' {
    description 'Claude Code, Copilot, Codex, or similar — runs real tasks against the instrumented repository'
  }

  // ─────────────────────────────────────────────────────────────────────────
  // External systems — the repository being measured, its task corpus, and
  // the forge that hosts CI/hook enforcement.
  // ─────────────────────────────────────────────────────────────────────────

  repoUnderTest = externalSystem 'Repository under test' {
    description 'The codebase being measured — source of the task corpus (git history) and the target of observe/migrate'
  }

  codeprobe = externalSystem 'CodeProbe' {
    description 'Mines evaluation tasks from a repository’s own merged PRs and records agent transcripts against them — the contamination-resistant task corpus AOA scores against'
    link https://github.com/sjarmak/codeprobe 'sjarmak/codeprobe'
  }

  forge = externalSystem 'Forge (GitHub)' {
    description 'Hosts CI and pre-commit hooks where compiled policy planes and the reproduction-before-mutation gate run'
  }

  // ─────────────────────────────────────────────────────────────────────────
  // The AOA system.
  // ─────────────────────────────────────────────────────────────────────────

  aoa = system 'AOA Toolkit' {
    description 'Runs an agent against real tasks mined from a repository, then scores retrieval locality, edit locality, invariant discoverability, and mutation surface'
    link ../README.md 'README — quickstart'

    cli = container 'aoa CLI' {
      #built
      description 'Single Rust binary wiring every subcommand to its library crate: observe, audit, lint-context, eval, gap, recommend, report, falsify, policy, enforce, migrate, init. Human + JSON dual output'
      technology 'Rust'
      link ../crates/aoa/src/cli.rs 'crates/aoa/src/cli.rs'
      link ../crates/aoa/src/main.rs 'crates/aoa/src/main.rs'
    }

    // ── Domain kernel ───────────────────────────────────────────────────────
    domain = container 'Domain kernel' {
      description 'The vocabulary every other half needs to name a held-out subject, and nothing else — no gating, no policy, no judgment'

      kernel = component 'aoa-domain' {
        #built
        description 'Held-out subject identity (SubjectKey, ExposureStatus), where a suite came from (HeldOutProvenance), and what one run observed (RunResult). The bottom of the stack: it has no internal dependencies and must never acquire one, because there is nothing below it to depend on'
        link ../crates/aoa-domain 'crates/aoa-domain/'
      }
    }

    trust = container 'Filesystem + git trust boundary' {
      description 'Decides which path a write may reach and which repository a command is run against, once, for every crate that touches the repository under test'

      pathTrust = component 'aoa-path-trust' {
        #built
        description 'Single-component name validation, a symlink-refusing join, openat(O_NOFOLLOW | O_DIRECTORY) directory acquisition, the repository-root resolver, and the environment a git subprocess may inherit. No internal dependencies, and no trace or measurement types'
        link ../crates/aoa-path-trust 'crates/aoa-path-trust/'
      }
    }

    // ── Trace + symbol-graph substrate ──────────────────────────────────────
    substrate = container 'Trace + symbol-graph substrate' {
      description 'Normalizes every run, live or recorded, into one 8-span trace schema, and indexes the repository into a confidence-tiered symbol graph'

      trace = component 'aoa-trace' {
        #built
        description 'OTel-style 8-span trace-event schema — the native format every other crate reads'
        link ../crates/aoa-trace 'crates/aoa-trace/'
      }
      codeprobeShim = component 'aoa-codeprobe-shim' {
        #built
        description 'Parses a codeprobe `claude -p --output-format stream-json` transcript into a native trace'
        link ../crates/aoa-codeprobe-shim 'crates/aoa-codeprobe-shim/'
      }
      observeShim = component 'aoa-observe-shim' {
        #built
        description 'Parses live `.aoa/traces` session logs (written by `aoa observe`) into a native trace'
        link ../crates/aoa-observe-shim 'crates/aoa-observe-shim/'
      }
      scipGraph = component 'aoa-scip-graph' {
        #built
        #risk
        description 'Indexes a repository into a SymbolGraph: SCIP when available (high-confidence), AST/line-scan otherwise (low-confidence), R15 confidence tiering. RISK: a degraded or empty index lowers a record’s weight, never raises the mutation-surface score, and disqualifies that repository from the falsify vote — the tiering is load-bearing, not cosmetic'
        link ../crates/aoa-scip-graph 'crates/aoa-scip-graph/'
      }
      metrics = component 'aoa-metrics' {
        #built
        description 'Computes retrieval locality, edit locality, invariant discoverability, and mutation surface from a trace plus the symbol graph'
        link ../crates/aoa-metrics/src/lib.rs 'crates/aoa-metrics/src/lib.rs'
      }
    }

    // ── Read-only measurement (the shippable half) ──────────────────────────
    measure = container 'Read-only measurement' {
      description 'observe / audit / lint-context / eval — zero-write against the repository under test'

      bench = component 'aoa-bench' {
        #built
        description 'The codeprobe boundary: mined task/run contracts, held-out provenance, and canonical content-addressed measurement observations'
        link ../crates/aoa-bench 'crates/aoa-bench/'
      }
      audit = component 'aoa-audit' {
        #built
        description 'Zero-write telemetry install (`observe`) plus a read-only tiered audit punch-list (`audit`), fail-loud on `--fail-on tier1`'
        link ../crates/aoa-audit 'crates/aoa-audit/'
      }
      budget = component 'aoa-budget' {
        #built
        description 'Context-budget gate: transitive closure of context files, dual tokenizer, ceiling enforcement (`lint-context`)'
        link ../crates/aoa-budget 'crates/aoa-budget/'
      }
      lint = component 'aoa-lint' {
        #built
        description 'Config-file smell detectors mapped to the arXiv 2606.15828 taxonomy, composed with the budget closure'
        link ../crates/aoa-lint 'crates/aoa-lint/'
      }
      gap = component 'aoa-gap' {
        #built
        description 'Reward-hacking gap (R9) and held-out integrity canary (R0b) — the visible-vs-hidden success gap and its leakage guard'
        link ../crates/aoa-gap 'crates/aoa-gap/'
      }
      construct = component 'aoa-construct' {
        #built
        description 'Metric-trust determination (R9c): which metrics may gate, and the behavioral-signal precondition'
        link ../crates/aoa-construct 'crates/aoa-construct/'
      }
      corpus = component 'aoa-corpus' {
        #built
        description 'External-outcome corpus: revert mining, the Factory checkbox baseline, and rank correlation'
        link ../crates/aoa-corpus 'crates/aoa-corpus/'
      }
      recommend = component 'aoa-recommend' {
        #built
        description 'Joins audit findings, construct-validity mode, and migration availability into per-finding recommendations'
        link ../crates/aoa-recommend 'crates/aoa-recommend/'
      }
    }

    // ── Trust gates ──────────────────────────────────────────────────────────
    gates = container 'Trust gates (R0 / R5 / R7)' {
      description 'The gates that decide whether migrate is worth trusting on a given repository, and whether a mutation may proceed at all'

      falsify = component 'aoa-falsify' {
        #built
        #risk
        description 'R0 falsification gate: across at least five held-out repositories, proceeds to migrate only if repo-delta beats harness-delta on held-out success for a majority; a tie defaults to pivot. RISK: premortem’s six independent, mutually blind reviews each broke this gate a different way and five of six scored the failure 12/12 — hardened into R0′ with a robust / abstaining / monitored verdict rather than a one-shot boolean'
        link ../crates/aoa-falsify 'crates/aoa-falsify/'
      }
      falsifyBuild = component 'aoa-falsify-build' {
        #built
        #risk
        description 'Assembles paired codeprobe runs into content-addressed R0 evidence, FalsifyInput, and an inspectable build report without spawning the CLI'
        link ../crates/aoa-falsify-build 'crates/aoa-falsify-build/'
      }
      policy = component 'aoa-policy' {
        #built
        description 'Compiles a single aoa-policy.yaml into three enforcement planes (CI check, pre-commit hook, lint) — R5'
        link ../crates/aoa-policy 'crates/aoa-policy/'
      }
      enforce = component 'aoa-enforce' {
        #built
        description 'Reproduction-before-mutation gate primitives — R7'
        link ../crates/aoa-enforce 'crates/aoa-enforce/'
      }
    }

    // ── Repository-mutating migration ───────────────────────────────────────
    migrate = container 'Repository-mutating migration' {
      #evolving
      #risk
      // No `link` here on purpose: the migrator component below carries it. A
      // container and the component inside it both linking aoa-migrate would
      // make an arrow drawn at either one ambiguous about what it claims, and
      // the container would become the way around the dependency check.
      description 'The only write-gated half. Dry-run by default; applies reversible, one-commit-per-fix code-layer cleanups. RISK: trustworthy only where falsify has cleared the repository — the whole point of the gate is that this container earns trust per-repo, not once, globally'

      migrator = component 'aoa-migrate' {
        #evolving
        description 'Dead-import removal and similar structural fixes, one commit per fix, rollback on demand'
        link ../crates/aoa-migrate 'crates/aoa-migrate/'
      }
    }
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Relationships.
  // ─────────────────────────────────────────────────────────────────────────

  operator -> aoa.cli 'aoa observe / audit / lint-context / eval / falsify / migrate'
  agentUnderTest -> repoUnderTest 'runs a real task; every turn logged as an 8-span trace'

  // Composition root. Drawn where the CLI is what joins two crates that do not
  // know each other — these hand-offs are the ones that would otherwise be
  // mistaken for dependencies between the libraries themselves. The CLI depends
  // on every library; only the joins are drawn.
  aoa.cli -> aoa.trust.pathTrust 'resolves the repository root every subcommand is anchored to'
  aoa.cli -> aoa.substrate.scipGraph 'indexes the repository under test'
  aoa.cli -> aoa.substrate.metrics 'hands over the trace and the resulting symbol graph to be scored'
  aoa.cli -> aoa.measure.gap 'hands over scored run outcomes to the reward-hacking check'
  aoa.cli -> aoa.measure.recommend 'projects the migration registry into the owned rows recommend joins against'
  aoa.cli -> aoa.migrate.migrator 'reads the fix registry to build that projection'

  aoa.trust.pathTrust -> repoUnderTest 'asks git for the top level and git directory, and refuses a path that leaves them'

  // Substrate — normalize whatever produced the run, index the repo.
  aoa.substrate.observeShim -> repoUnderTest 'reads live .aoa/traces session logs'
  aoa.substrate.codeprobeShim -> codeprobe 'parses recorded claude -p stream-json transcripts'
  aoa.substrate.scipGraph -> repoUnderTest 'indexes via SCIP, or AST / line-scan when SCIP is unavailable'
  aoa.substrate.observeShim -> aoa.substrate.trace 'normalizes into the native trace schema'
  aoa.substrate.observeShim -> aoa.substrate.codeprobeShim 'shares the capped-read primitives and the TraceBackend conformance contract'
  aoa.substrate.codeprobeShim -> aoa.substrate.trace 'normalizes into the native trace schema'
  aoa.substrate.scipGraph -> aoa.substrate.trace 'builds the SymbolGraph and index-quality tier the trace crate declares'
  aoa.substrate.metrics -> aoa.substrate.trace 'reads the 8-span trace and the SymbolGraph declared alongside it'

  // Measurement.
  aoa.measure.bench -> codeprobe 'loads mined task directories'
  aoa.measure.bench -> aoa.domain.kernel 'names mined subjects and their held-out provenance'
  aoa.measure.audit -> repoUnderTest 'installs zero-write telemetry (observe)'
  aoa.measure.audit -> aoa.substrate.trace 'validates the traces observe installs and reports their span counts'
  aoa.measure.audit -> aoa.trust.pathTrust 'installs telemetry and resolves the hook path through the trust boundary'
  aoa.measure.audit -> aoa.substrate.observeShim 'loads the observed-session corpus that observe wrote'
  aoa.measure.audit -> aoa.substrate.metrics 'ranks a tiered punch-list from scored metrics'
  aoa.measure.audit -> aoa.measure.budget 'counts the context budget over the resolved closure'
  aoa.measure.audit -> aoa.measure.construct 'reads the construct-validity determination before a metric is allowed to gate'
  aoa.measure.audit -> aoa.measure.corpus 'reads the pre-commit hook markers the checkbox baseline scores, so both commands state one fact'
  aoa.measure.budget -> repoUnderTest 'reads the transitive closure of context files'
  aoa.measure.lint -> aoa.measure.budget 'composes config-smell detection with the context-budget closure'
  aoa.measure.gap -> aoa.domain.kernel 'reads run outcomes and canary items for the visible-vs-hidden gap'
  aoa.measure.corpus -> aoa.measure.construct 'correlates mined external outcomes against the gating candidates'
  aoa.measure.recommend -> aoa.measure.audit 'joins audit findings'
  aoa.measure.recommend -> aoa.measure.construct 'joins construct-validity mode'

  // Trust gates.
  aoa.gates.falsifyBuild -> aoa.measure.bench 'loads task and run evidence'
  aoa.gates.falsifyBuild -> aoa.substrate.scipGraph 'derives answer-task convention inputs'
  aoa.gates.falsifyBuild -> aoa.substrate.codeprobeShim 'parses arm transcripts'
  aoa.gates.falsifyBuild -> aoa.substrate.metrics 'scores trace-convention inputs and carries the index-confidence tier'
  aoa.gates.falsifyBuild -> aoa.domain.kernel 'stamps each arm with the subject exposure it was run under'
  aoa.gates.falsifyBuild -> aoa.gates.falsify 'constructs the scored FalsifyInput'
  aoa.gates.falsify -> aoa.domain.kernel 'reads held-out provenance and exposure status per repository'
  aoa.gates.falsify -> aoa.substrate.trace 'reads the index-confidence tier the evidence carries'
  aoa.gates.falsify -> aoa.migrate 'gates trust: proceed / pivot / inconclusive' {
    // Not a code edge, and it must not become one: the verdict is read by an
    // operator deciding whether to trust migrate on this repository, not called
    // by a crate. See CONCEPTUAL_EDGES in crates/aoa/tests/architecture_model.rs.
    #conceptual
  }
  aoa.gates.policy -> forge 'compiles aoa-policy.yaml into CI / hook / lint enforcement planes'
  aoa.gates.enforce -> repoUnderTest 'blocks a mutation that has not first reproduced the failure it claims to fix'
  aoa.gates.enforce -> aoa.substrate.trace 'reads the reproduction run as trace spans'
  aoa.gates.enforce -> aoa.trust.pathTrust 'validates the session name the live log file is named after'

  // Migration — the only half that writes to the repository under test.
  aoa.migrate.migrator -> aoa.measure.audit 'reads the findings audit raised, and fixes at those sites'
  aoa.migrate.migrator -> repoUnderTest 'applies reversible, one-commit-per-fix changes (dry-run by default)' {
    #evolving
  }
}
