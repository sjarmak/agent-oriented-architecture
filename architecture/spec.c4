// Element kinds, tags, and custom colors for the `aoa` architecture model.
//
// Tags encode delivery state so planned / research work is visually distinct
// from what is already built:
//   #built     — code path exists and is exercised
//   #evolving  — built but the contract/trust decision is still moving
//   #planned   — designed, not yet implemented (or v1 is a stub/heuristic)
//   #research  — speculative research track

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color slate
    }
  }

  element system

  element container {
    style {
      shape rectangle
    }
  }

  element component

  element datastore {
    style {
      shape cylinder
    }
  }

  // Deployment model — where each piece runs at review time.
  deploymentNode host {
    style {
      shape rectangle
      color slate
    }
  }
  deploymentNode proc

  tag built {
    color #16a34a
  }
  tag evolving {
    color #d97706
  }
  tag planned {
    color #64748b
  }
  tag research {
    color #6366f1
  }

  // Cross-cutting: carried by any element that is a known risk / open question
  // for the design review (in addition to its delivery-state tag).
  tag risk {
    color #dc2626
  }

  // Carried by a relationship that is deliberately NOT a code dependency — a
  // decision or a gate rather than a call. Every other arrow between two crates
  // in model.c4 has to be a real production dependency, so this tag is the one
  // exemption and each use is registered with a reason in
  // crates/aoa/tests/architecture_model.rs.
  tag conceptual {
    color #64748b
  }
}
