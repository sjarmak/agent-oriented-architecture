{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.dev/schemas/trace.schema.json",
  "title": "AOA Trace File",
  "description": "A trace file is a JSON object with an optional `version` and a `spans` array. Spans are ordered by a monotonically non-decreasing `seq` key.",
  "type": "object",
  "required": ["spans"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Wire-format version of the trace envelope. Absent is treated as version 1 for backward compatibility; a reader rejects a version it does not support.",
      "type": "integer",
      "minimum": 0
    },
    "spans": {
      "type": "array",
      "items": { "$ref": "#/$defs/span" }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["type", "source", "seq"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "The kind of span. One of the eleven stable discriminants. Only write.committed attests a mutation that landed; write.attempt is intent recorded before execution, and write.failed/write.denied/write.blocked all mean the write did not land.",
          "type": "string",
          "enum": [
            "retrieval.search",
            "file.read",
            "symbol.lookup",
            "write.attempt",
            "write.committed",
            "write.failed",
            "write.denied",
            "write.blocked",
            "test.run",
            "gateway.invoke",
            "abstain"
          ]
        },
        "source": {
          "description": "Provenance of the span.",
          "type": "string",
          "enum": ["native", "reconstructed"]
        },
        "seq": {
          "description": "Monotonic ordering key within the trace.",
          "type": "integer",
          "minimum": 0
        },
        "attributes": {
          "description": "Free-form span-type-specific metadata. Keys named here carry a published meaning that readers depend on; any other key is unconstrained.",
          "type": "object",
          "properties": {
            "command": {
              "description": "The command executed by a test.run span.",
              "type": "string"
            },
            "path": {
              "description": "The repository or workspace path accessed by a file.read or write-lifecycle span.",
              "type": "string"
            },
            "policy": {
              "description": "The stable machine-readable policy key that caused a write.blocked span.",
              "type": "string"
            },
            "query": {
              "description": "The search query or pattern executed by a retrieval.search span.",
              "type": "string"
            },
            "reason": {
              "description": "The human-readable reason that a write.blocked span was denied.",
              "type": "string"
            },
            "results": {
              "description": "The artifacts a retrieval span ranked, best first. Absent and empty are DIFFERENT observations and readers must not collapse them: absent means the trace carries no retrieval-ranking instrumentation at all (no evidence, so Recall@k and MRR are unavailable), while an empty array means a retriever ran and ranked nothing (a measured zero, so Recall@k is 0.0). A producer that cannot report a ranking must omit the key rather than emit an empty array.",
              "type": "array",
              "items": { "type": "string" }
            },
            "source": {
              "description": "The source artifact that should be edited instead of a generated artifact named by a write.blocked span.",
              "type": "string"
            },
            "symbol": {
              "description": "The symbol identifier resolved by a symbol.lookup span.",
              "type": "string"
            },
            "target_unresolved": {
              "description": "True when a native write attempt, commit, or block preserves observed write intent or outcome but its tool call supplied no usable path.",
              "const": true
            },
            "tool": {
              "description": "The external tool invoked by a gateway.invoke span.",
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "retrieval.search" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": { "required": ["query"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "file.read",
                  "write.failed",
                  "write.denied"
                ]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": { "required": ["path"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "write.attempt",
                  "write.committed"
                ]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["path"] },
                  { "required": ["target_unresolved"] }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "symbol.lookup" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": { "required": ["symbol"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "write.blocked" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": {
                "anyOf": [
                  { "required": ["path"] },
                  { "required": ["policy"] },
                  { "required": ["target_unresolved"] }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attributes": { "required": ["target_unresolved"] }
            },
            "required": ["attributes"]
          },
          "then": {
            "properties": {
              "attributes": {
                "not": {
                  "anyOf": [
                    { "required": ["path"] },
                    { "required": ["policy"] }
                  ]
                }
              },
              "source": { "const": "native" },
              "type": {
                "enum": [
                  "write.attempt",
                  "write.committed",
                  "write.blocked"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "write.blocked" },
              "attributes": {
                "properties": {
                  "policy": { "const": "generated_artifact" }
                },
                "required": ["policy"]
              }
            },
            "required": ["type", "attributes"]
          },
          "then": {
            "properties": {
              "attributes": { "required": ["source"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "test.run" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": { "required": ["command"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "gateway.invoke" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["attributes"],
            "properties": {
              "attributes": { "required": ["tool"] }
            }
          }
        }
      ]
    }
  }
}
